<?xml version="1.0" encoding="utf-8"?>
<!-- The launch screen's icon: the app's eight-pointed star in gold, turning
     an eighth of a circle again and again (after which it looks as it began,
     so the turn never jumps). Android 12 and later play it; earlier versions
     show it still. A splash icon without a background is 288 units with its
     drawing inside the middle 192; the star's radius is 80. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="288dp"
            android:height="288dp"
            android:viewportWidth="288"
            android:viewportHeight="288">
            <group
                android:name="star"
                android:pivotX="144"
                android:pivotY="144">
                <path
                    android:fillColor="#248A6416"
                    android:pathData="M144,64 L224,144 L144,224 L64,144 Z M200.57,87.43 L200.57,200.57 L87.43,200.57 L87.43,87.43 Z" />
                <path
                    android:pathData="M144,64 L224,144 L144,224 L64,144 Z M200.57,87.43 L200.57,200.57 L87.43,200.57 L87.43,87.43 Z"
                    android:strokeColor="#8A6416"
                    android:strokeLineJoin="round"
                    android:strokeWidth="6.5" />
            </group>
            <path
                android:fillColor="#8A6416"
                android:pathData="M144,131.2 A12.8,12.8 0 1,1 143.99,131.2 Z" />
        </vector>
    </aapt:attr>
    <target android:name="star">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="1600"
                android:interpolator="@android:anim/linear_interpolator"
                android:propertyName="rotation"
                android:repeatCount="infinite"
                android:valueFrom="0"
                android:valueTo="45" />
        </aapt:attr>
    </target>
</animated-vector>
