<?xml version="1.0" encoding="utf-8"?>
<!-- The contours draw once, then the emblem hops until the launch screen
     goes. The static vector is also the resting frame on older launchers. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector android:width="288dp" android:height="288dp"
            android:viewportWidth="288" android:viewportHeight="288">
            <group android:name="emblem" android:pivotX="144" android:pivotY="224">
                <path android:name="diamond" android:fillColor="#248A6416"
                    android:pathData="M144,64 L224,144 L144,224 L64,144 Z"
                    android:strokeColor="#8A6416" android:strokeLineJoin="round" android:strokeWidth="6.5" />
                <path android:name="square" android:fillColor="#248A6416"
                    android:pathData="M200.57,87.43 L200.57,200.57 L87.43,200.57 L87.43,87.43 Z"
                    android:strokeColor="#8A6416" android:strokeLineJoin="round" android:strokeWidth="6.5" />
                <path android:fillColor="#8A6416"
                    android:pathData="M144,131.2 A12.8,12.8 0 1,1 143.99,131.2 Z" />
            </group>
        </vector>
    </aapt:attr>
    <target android:name="diamond">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="trimPathEnd" android:duration="380"
                android:valueFrom="0" android:valueTo="1" android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="square">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="trimPathEnd" android:duration="520"
                android:valueFrom="0" android:valueTo="1" android:valueType="floatType" />
        </aapt:attr>
    </target>
    <!-- The emblem hops again and again while the app opens: it starts when
         the contours are drawn and goes on until the launch screen goes, so
         the screen is never still while the app is not ready. Each hop is the
         first 53% of its 1.4 s and the emblem rests for the rest, so it rests
         from 4062 to 4720 ms, where Android 12 and 13 stop it
         (windowSplashScreenAnimationDuration, 4500 ms, in styles.xml). -->
    <target android:name="emblem">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="1400" android:startOffset="520"
                android:repeatCount="-1" android:repeatMode="restart">
                <propertyValuesHolder android:propertyName="translateY">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.19" android:value="-15"
                        android:interpolator="@android:anim/decelerate_interpolator" />
                    <keyframe android:fraction="0.36" android:value="0"
                        android:interpolator="@android:anim/accelerate_interpolator" />
                    <keyframe android:fraction="1" android:value="0" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="scaleY">
                    <keyframe android:fraction="0" android:value="1" />
                    <keyframe android:fraction="0.36" android:value="1" />
                    <keyframe android:fraction="0.43" android:value="0.91" />
                    <keyframe android:fraction="0.53" android:value="1" />
                    <keyframe android:fraction="1" android:value="1" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
</animated-vector>
