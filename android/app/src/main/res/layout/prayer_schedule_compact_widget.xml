<?xml version="1.0" encoding="utf-8"?>
<!-- Six times and the next prayer's countdown in a single launcher row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/schedule_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingTop="3dp"
    android:paddingEnd="6dp"
    android:paddingBottom="3dp">
    <TextView
        android:id="@+id/schedule_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:text="@string/prayer_widget_empty"
        android:textColor="@color/widget_text"
        android:textSize="12sp"
        android:visibility="gone" />
    <LinearLayout
        android:id="@+id/schedule_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/schedule_next_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="@string/widget_preview_schedule_next"
                android:textColor="@color/widget_accent"
                android:textSize="11sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/schedule_remaining"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="@string/widget_preview_remaining"
                android:textColor="@color/widget_accent"
                android:textSize="11sp" />
            <Chronometer
                android:id="@+id/schedule_seconds"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textColor="@color/widget_accent"
                android:textSize="11sp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/schedule_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:maxWidth="100dp"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="@color/widget_text_muted"
                android:textSize="10sp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/schedule_hijri"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:maxWidth="120dp"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="@color/widget_text_muted"
                android:textSize="10sp"
                android:visibility="gone" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/schedule_dates_stacked"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                android:id="@+id/schedule_date_stacked"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="@string/widget_preview_date"
                android:textColor="@color/widget_text_muted"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/schedule_hijri_stacked"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="@string/widget_preview_hijri"
                android:textColor="@color/widget_accent"
                android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <FrameLayout
                android:id="@+id/schedule_row_0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.85"
                android:paddingEnd="2dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="start|center_vertical"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                <TextView
                    android:id="@+id/schedule_name_0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="@string/widget_preview_fajr"
                    android:textColor="@color/widget_text"
                    android:fontFamily="sans-serif-condensed"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/schedule_time_0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="@string/widget_preview_compact_fajr_time"
                    android:textColor="@color/widget_text"
                    android:fontFamily="sans-serif-condensed"
                    android:textSize="11sp"
                    android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/schedule_row_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.15"
                android:paddingStart="2dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="start|center_vertical"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                <TextView
                    android:id="@+id/schedule_name_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="@string/widget_preview_sunrise"
                    android:textColor="@color/widget_text"
                    android:fontFamily="sans-serif-condensed"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/schedule_time_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="@string/widget_preview_compact_sunrise_time"
                    android:textColor="@color/widget_text"
                    android:fontFamily="sans-serif-condensed"
                    android:textSize="11sp"
                    android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <FrameLayout
                android:id="@+id/schedule_row_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/widget_row_next"
                android:layout_weight="1.05"
                android:paddingEnd="2dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="start|center_vertical"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                <TextView
                    android:id="@+id/schedule_name_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="@string/widget_preview_dhuhr"
                    android:textColor="@color/widget_text"
                    android:fontFamily="sans-serif-condensed"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/schedule_time_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="@string/widget_preview_compact_dhuhr_time"
                    android:textColor="@color/widget_text"
                    android:fontFamily="sans-serif-condensed"
                    android:textSize="11sp"
                    android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/schedule_row_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.95"
                android:paddingStart="2dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="start|center_vertical"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                <TextView
                    android:id="@+id/schedule_name_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="@string/widget_preview_asr"
                    android:textColor="@color/widget_text"
                    android:fontFamily="sans-serif-condensed"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/schedule_time_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="@string/widget_preview_compact_asr_time"
                    android:textColor="@color/widget_text"
                    android:fontFamily="sans-serif-condensed"
                    android:textSize="11sp"
                    android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <FrameLayout
                android:id="@+id/schedule_row_4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.05"
                android:paddingEnd="2dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="start|center_vertical"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                <TextView
                    android:id="@+id/schedule_name_4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="@string/widget_preview_maghrib"
                    android:textColor="@color/widget_text"
                    android:fontFamily="sans-serif-condensed"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/schedule_time_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="@string/widget_preview_compact_maghrib_time"
                    android:textColor="@color/widget_text"
                    android:fontFamily="sans-serif-condensed"
                    android:textSize="11sp"
                    android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/schedule_row_5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.95"
                android:paddingStart="2dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="start|center_vertical"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                <TextView
                    android:id="@+id/schedule_name_5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="@string/widget_preview_isha"
                    android:textColor="@color/widget_text"
                    android:fontFamily="sans-serif-condensed"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/schedule_time_5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="@string/widget_preview_compact_isha_time"
                    android:textColor="@color/widget_text"
                    android:fontFamily="sans-serif-condensed"
                    android:textSize="11sp"
                    android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
