<?xml version="1.0" encoding="utf-8"?>
<!-- Only the next prayer has a countdown, centered above its name and time,
     inside its highlight, with a gap under it and its font's own padding: a
     phone's font may draw taller than its line, and the two lines must never
     touch. No star behind the text: nothing crosses the date. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/schedule_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg">


    <LinearLayout
        android:id="@+id/schedule_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <!-- The date lines start where the rows' text does (8dp in from the
             rows' own edge), and sit a little clear of the corner. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/schedule_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:text="@string/widget_preview_date"
                    android:textColor="@color/widget_text"
                    android:textSize="11sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/schedule_hijri"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:text="@string/widget_preview_hijri"
                    android:textAlignment="viewStart"
                    android:textColor="@color/widget_accent"
                    android:textSize="10sp" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/schedule_row_0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp">

            <TextView
                android:id="@+id/schedule_remaining_0"
                android:layout_marginBottom="@dimen/schedule_countdown_gap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="true"
                android:singleLine="true"
                android:ellipsize="end"
                android:gravity="center"
                android:text="@string/widget_preview_remaining"
                android:textColor="@color/widget_accent"
                android:textSize="10sp"
                android:visibility="gone" />
            <Chronometer
                android:id="@+id/schedule_seconds_0"
                android:layout_marginBottom="@dimen/schedule_countdown_gap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="true"
                android:singleLine="true"
                android:gravity="center"
                android:textColor="@color/widget_accent"
                android:textSize="10sp"
                android:visibility="gone" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/schedule_name_0"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:text="@string/widget_preview_fajr"
                    android:textAlignment="viewStart"
                    android:textColor="@color/widget_text"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/schedule_time_0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:text="@string/widget_preview_fajr_time"
                    android:textAlignment="viewEnd"
                    android:textColor="@color/widget_text"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/schedule_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp">

            <TextView
                android:id="@+id/schedule_remaining_1"
                android:layout_marginBottom="@dimen/schedule_countdown_gap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="true"
                android:singleLine="true"
                android:ellipsize="end"
                android:gravity="center"
                android:text="@string/widget_preview_remaining"
                android:textColor="@color/widget_accent"
                android:textSize="10sp"
                android:visibility="gone" />
            <Chronometer
                android:id="@+id/schedule_seconds_1"
                android:layout_marginBottom="@dimen/schedule_countdown_gap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="true"
                android:singleLine="true"
                android:gravity="center"
                android:textColor="@color/widget_accent"
                android:textSize="10sp"
                android:visibility="gone" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/schedule_name_1"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:text="@string/widget_preview_sunrise"
                    android:textAlignment="viewStart"
                    android:textColor="@color/widget_text_muted"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/schedule_time_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:text="@string/widget_preview_sunrise_time"
                    android:textAlignment="viewEnd"
                    android:textColor="@color/widget_text_muted"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/schedule_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/widget_row_next"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">

            <TextView
                android:id="@+id/schedule_remaining_2"
                android:layout_marginBottom="@dimen/schedule_countdown_gap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="true"
                android:singleLine="true"
                android:ellipsize="end"
                android:gravity="center"
                android:text="@string/widget_preview_remaining"
                android:textColor="@color/widget_accent"
                android:textSize="10sp"
                android:visibility="visible" />
            <Chronometer
                android:id="@+id/schedule_seconds_2"
                android:layout_marginBottom="@dimen/schedule_countdown_gap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="true"
                android:singleLine="true"
                android:gravity="center"
                android:textColor="@color/widget_accent"
                android:textSize="10sp"
                android:visibility="gone" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/schedule_name_2"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:text="@string/widget_preview_dhuhr"
                    android:textAlignment="viewStart"
                    android:textColor="@color/widget_text"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/schedule_time_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:text="@string/widget_preview_dhuhr_time"
                    android:textAlignment="viewEnd"
                    android:textColor="@color/widget_text"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/schedule_row_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp">

            <TextView
                android:id="@+id/schedule_remaining_3"
                android:layout_marginBottom="@dimen/schedule_countdown_gap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="true"
                android:singleLine="true"
                android:ellipsize="end"
                android:gravity="center"
                android:text="@string/widget_preview_remaining"
                android:textColor="@color/widget_accent"
                android:textSize="10sp"
                android:visibility="gone" />
            <Chronometer
                android:id="@+id/schedule_seconds_3"
                android:layout_marginBottom="@dimen/schedule_countdown_gap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="true"
                android:singleLine="true"
                android:gravity="center"
                android:textColor="@color/widget_accent"
                android:textSize="10sp"
                android:visibility="gone" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/schedule_name_3"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:text="@string/widget_preview_asr"
                    android:textAlignment="viewStart"
                    android:textColor="@color/widget_text"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/schedule_time_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:text="@string/widget_preview_asr_time"
                    android:textAlignment="viewEnd"
                    android:textColor="@color/widget_text"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/schedule_row_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp">

            <TextView
                android:id="@+id/schedule_remaining_4"
                android:layout_marginBottom="@dimen/schedule_countdown_gap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="true"
                android:singleLine="true"
                android:ellipsize="end"
                android:gravity="center"
                android:text="@string/widget_preview_remaining"
                android:textColor="@color/widget_accent"
                android:textSize="10sp"
                android:visibility="gone" />
            <Chronometer
                android:id="@+id/schedule_seconds_4"
                android:layout_marginBottom="@dimen/schedule_countdown_gap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="true"
                android:singleLine="true"
                android:gravity="center"
                android:textColor="@color/widget_accent"
                android:textSize="10sp"
                android:visibility="gone" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/schedule_name_4"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:text="@string/widget_preview_maghrib"
                    android:textAlignment="viewStart"
                    android:textColor="@color/widget_text"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/schedule_time_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:text="@string/widget_preview_maghrib_time"
                    android:textAlignment="viewEnd"
                    android:textColor="@color/widget_text"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/schedule_row_5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp">

            <TextView
                android:id="@+id/schedule_remaining_5"
                android:layout_marginBottom="@dimen/schedule_countdown_gap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="true"
                android:singleLine="true"
                android:ellipsize="end"
                android:gravity="center"
                android:text="@string/widget_preview_remaining"
                android:textColor="@color/widget_accent"
                android:textSize="10sp"
                android:visibility="gone" />
            <Chronometer
                android:id="@+id/schedule_seconds_5"
                android:layout_marginBottom="@dimen/schedule_countdown_gap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="true"
                android:singleLine="true"
                android:gravity="center"
                android:textColor="@color/widget_accent"
                android:textSize="10sp"
                android:visibility="gone" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/schedule_name_5"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:text="@string/widget_preview_isha"
                    android:textAlignment="viewStart"
                    android:textColor="@color/widget_text"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/schedule_time_5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:text="@string/widget_preview_isha_time"
                    android:textAlignment="viewEnd"
                    android:textColor="@color/widget_text"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
