<?xml version="1.0" encoding="utf-8"?>
<!-- The prayer card, four cells by two: the coming prayer large at the top,
     its time and how long is left (to the second when the person chose
     it), and the day's prayers and sunrise along the bottom with the coming one
     framed in gold. The text here is the sample shown in the widget picker,
     with Asr coming; PrayerWidgetRenderer replaces it. -->
<!-- The coming prayer at the top, the day's five at the bottom; the star sits
     in the middle, so a taller widget shows it in the room between them. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg">

    <!-- Behind the empty middle of the top row, clear of every text. -->
    <ImageView
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="center"
        android:layout_marginTop="-6dp"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_card_star" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="top"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/card_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="@string/prayer_widget_label"
                    android:textAlignment="viewStart"
                    android:textColor="@color/widget_card_gold"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Two lines, so the "set your location" hint is not cut. -->
                <TextView
                    android:id="@+id/card_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/widget_preview_asr"
                    android:textAlignment="viewStart"
                    android:textColor="@color/widget_card_text"
                    android:textSize="26sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/card_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="@string/widget_preview_asr_time"
                    android:textColor="@color/widget_card_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/card_remaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="@string/widget_preview_remaining"
                    android:textColor="@color/widget_card_gold"
                    android:textSize="11sp" />

                <!-- Counts down on its own, to the second, when chosen. -->
                <Chronometer
                    android:id="@+id/card_seconds"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textColor="@color/widget_card_gold"
                    android:textSize="11sp"
                    android:visibility="gone" />

            </LinearLayout>
        </LinearLayout>

        <!-- The day on one line under the coming prayer: the date at the
             start, the Hijri date at the end. Kept out of the column beside
             the name, where a short widget cut it off. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/card_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/widget_preview_date"
                android:textAlignment="viewStart"
                android:textColor="@color/widget_card_muted"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/card_hijri"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:singleLine="true"
                android:text="@string/widget_preview_hijri"
                android:textColor="@color/widget_card_muted"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- A home-screen widget can hold only certain views; a plain View
             is not one, so the rule is an empty FrameLayout. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:background="@color/widget_card_line" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">
                <LinearLayout
                    android:id="@+id/card_cell_0"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/card_cell_name_0"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="@string/widget_preview_fajr"
                        android:textAlignment="center"
                        android:textColor="@color/widget_card_muted"
                        android:textSize="10sp" />
                    <TextView
                        android:id="@+id/card_cell_time_0"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        android:singleLine="true"
                        android:text="@string/widget_preview_fajr_time"
                        android:textColor="@color/widget_card_text"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/card_cell_1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/card_cell_name_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="@string/widget_preview_sunrise"
                        android:textAlignment="center"
                        android:textColor="@color/widget_card_muted"
                        android:textSize="10sp" />
                    <TextView
                        android:id="@+id/card_cell_time_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        android:singleLine="true"
                        android:text="@string/widget_preview_sunrise_time"
                        android:textColor="@color/widget_card_text"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/card_cell_2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/card_cell_name_2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="@string/widget_preview_dhuhr"
                        android:textAlignment="center"
                        android:textColor="@color/widget_card_muted"
                        android:textSize="10sp" />
                    <TextView
                        android:id="@+id/card_cell_time_2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        android:singleLine="true"
                        android:text="@string/widget_preview_dhuhr_time"
                        android:textColor="@color/widget_card_text"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">
                <LinearLayout
                    android:id="@+id/card_cell_3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/widget_card_cell_next"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/card_cell_name_3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="@string/widget_preview_asr"
                        android:textAlignment="center"
                        android:textColor="@color/widget_card_muted"
                        android:textSize="10sp" />
                    <TextView
                        android:id="@+id/card_cell_time_3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        android:singleLine="true"
                        android:text="@string/widget_preview_asr_time"
                        android:textColor="@color/widget_card_text"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/card_cell_4"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/card_cell_name_4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="@string/widget_preview_maghrib"
                        android:textAlignment="center"
                        android:textColor="@color/widget_card_muted"
                        android:textSize="10sp" />
                    <TextView
                        android:id="@+id/card_cell_time_4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        android:singleLine="true"
                        android:text="@string/widget_preview_maghrib_time"
                        android:textColor="@color/widget_card_text"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/card_cell_5"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/card_cell_name_5"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="@string/widget_preview_isha"
                        android:textAlignment="center"
                        android:textColor="@color/widget_card_muted"
                        android:textSize="10sp" />
                    <TextView
                        android:id="@+id/card_cell_time_5"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        android:singleLine="true"
                        android:text="@string/widget_preview_isha_time"
                        android:textColor="@color/widget_card_text"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
