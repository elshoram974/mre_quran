<?xml version="1.0" encoding="utf-8"?>
<!-- The next prayer, one row tall and two cells wide: its name at the start,
     on the plain card (no star behind the text, so nothing crosses it),
     its time and the time left at the end. Two short lines each side, sized
     to fit the shortest row a launcher gives. The text here is the sample shown
     in the widget picker; PrayerWidgetProvider replaces it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/prayer_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <!-- The name takes the room the time leaves, so it never breaks
             inside a word. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/prayer_widget_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/prayer_widget_label"
                android:textAlignment="viewStart"
                android:textColor="@color/widget_accent"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Two lines, so the "set your location" hint is not cut. -->
            <TextView
                android:id="@+id/prayer_widget_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:includeFontPadding="false"
                android:text="@string/widget_preview_fajr"
                android:textAlignment="viewStart"
                android:textColor="@color/widget_text"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/prayer_widget_times"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/prayer_widget_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:text="@string/widget_preview_fajr_time"
                android:textColor="@color/widget_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/prayer_widget_remaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:includeFontPadding="false"
                android:textAlignment="viewEnd"
                android:text="@string/widget_preview_remaining"
                android:textColor="@color/widget_accent"
                android:textSize="11sp" />

            <!-- Counts down on its own, to the second, when chosen. -->
            <Chronometer
                android:id="@+id/prayer_widget_seconds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:textColor="@color/widget_accent"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/prayer_widget_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/widget_preview_date"
            android:textAlignment="viewStart"
            android:textColor="@color/widget_text_muted"
            android:textSize="9sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
