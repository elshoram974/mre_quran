<?xml version="1.0" encoding="utf-8"?>
<!-- Shown while the app starts, before Flutter draws its own splash: the
     default (sepia) paper and the app's star, where StartupSplash draws it,
     so the hand-over is seamless. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_paper" />
    <item android:drawable="@drawable/launch_star" android:gravity="center" />
</layer-list>
